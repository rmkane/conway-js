{
  "name": "conway",
  "version": "1.0.0",
  "private": true,
  "homepage": "https://github.com/rmkane/conway-js#readme",
  "bugs": {
    "url": "https://github.com/rmkane/conway-js/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rmkane/conway-js.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "analyze": "fallow --only dead-code,dupes",
    "analyze:full": "fallow",
    "analyze:dead-code": "fallow dead-code",
    "analyze:dupes": "fallow dupes",
    "analyze:health": "fallow health",
    "analyze:hotspots": "fallow health --hotspots",
    "analyze:targets": "fallow health --targets",
    "analyze:audit": "fallow audit",
    "analyze:security": "fallow security",
    "analyze:flags": "fallow flags",
    "analyze:list": "fallow list",
    "analyze:viz": "fallow viz --no-open",
    "analyze:watch": "fallow watch",
    "analyze:fix": "fallow fix",
    "hooks": "./scripts/install-hooks.sh",
    "precommit": "oxfmt --check && oxlint && vitest run && tsc --noEmit"
  },
  "dependencies": {
    "@conway/dom": "workspace:*",
    "@conway/geom": "workspace:*",
    "@conway/query": "workspace:*",
    "@conway/rng": "workspace:*",
    "lucide": "^1.34.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "fallow": "^3.14.0",
    "happy-dom": "^20.11.2",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.21.0"
}
