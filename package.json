{
  "name": "conway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "analyze": "fallow --only dead-code,dupes",
    "analyze:full": "fallow",
    "hooks": "./scripts/install-hooks.sh",
    "precommit": "oxfmt --check && oxlint && vitest run && tsc --noEmit"
  },
  "dependencies": {
    "@conway/dom": "workspace:*",
    "@conway/geom": "workspace:*",
    "@conway/rng": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "fallow": "^3.14.0",
    "happy-dom": "^20.11.2",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.21.0"
}
